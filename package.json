{
  "name": "converto",
  "productName": "Converto",
  "version": "0.1.0",
  "description": "Drop a file, pick a format, get the result. Everything runs on your computer.",
  "main": "src/main/main.js",
  "author": "Converto",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
